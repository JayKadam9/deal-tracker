name: Refresh deals and deploy

"on":
  schedule:
    # 09:00 Asia/Calcutta (IST is UTC+5:30)
    - cron: "30 3 * * *"
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: pages-and-refresh
  cancel-in-progress: false

jobs:
  refresh-and-deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Check out the repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Fetch today's deals
        id: fetch
        continue-on-error: true
        run: python3 scripts/fetch_deals.py --out data/deals.json
        # The script exits non-zero without overwriting data/deals.json if
        # BuyHatke blocks the runner or too few items qualify. The last
        # good list stays in the repo and is still deployed below.

      - name: Commit deals.json if it changed
        if: steps.fetch.outcome == 'success'
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/deals.json
          if git diff --staged --quiet; then
            echo "No change to data/deals.json"
          else
            git commit -m "Refresh Amazon.in deals ($(date -u +%Y-%m-%d))"
            git push
          fi

      - name: Warn if the fetch failed
        if: steps.fetch.outcome != 'success'
        run: |
          echo "::warning::Deal fetch failed or returned too few items. Deploying the last good data/deals.json."

      - name: Prepare Pages artifact
        run: |
          mkdir -p _site/data
          cp index.html styles.css app.js _site/
          cp data/deals.json _site/data/

      - name: Configure Pages
        uses: actions/configure-pages@v5

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: _site

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
